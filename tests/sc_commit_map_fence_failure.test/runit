#!/usr/bin/env bash
bash -n "$0" || exit 1

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh
set -o pipefail

dbnm=$1
[[ -z "$dbnm" ]] && dbnm=$DBNAME
master=$(getmaster)
[[ -n "$master" ]] || { echo "FAIL: could not find master"; exit 1; }

run() { cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" "$1"; }
fail() { echo "FAIL: $*"; exit 1; }
fences() {
	cdb2sql ${CDB2_OPTIONS} --host "$master" "$dbnm" \
		"exec procedure sys.cmd.send('bdb clminfo')" 2>/dev/null |
		grep -oP '(?<=SC publication fences: )[0-9]+'
}

run "create table t(i int, j int)" >/dev/null
run "create index ix_j on t(j)" >/dev/null
run "insert into t select value, value from generate_series(1, 2000)" >/dev/null

base_fences=$(fences)
base_version=$(run "select table_version('t')")

# Finalization inside a caller-owned DDL transaction installs RAM fences before
# the outer commit. A later DDL failure must remove them when the transaction
# aborts, just as the durable rows roll back.
if cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" - \
	>/tmp/sc_fence_outer_abort.$$ 2>&1 <<'EOF'
begin
alter table t {schema{int i int j int k}}$$
create table t {schema{int i}}$$
commit
EOF
then
	rm -f /tmp/sc_fence_outer_abort.$$
	fail "multi-DDL transaction unexpectedly succeeded"
fi
rm -f /tmp/sc_fence_outer_abort.$$
[[ "$(run "select table_version('t')")" == "$base_version" ]] ||
	fail "outer abort changed table version"
[[ "$(run 'select count(*) from t')" == "2000" ]] ||
	fail "outer abort changed table contents"
[[ "$(fences)" == "$base_fences" ]] ||
	fail "outer abort left published RAM fences"

expect_failed_rebuild() {
	local tunable=$1 after=$2 reset=${3:-2147483647} before
	before=$(fences)
	run "put tunable '$tunable' $after" >/dev/null ||
		fail "could not set $tunable=$after"
	if run "rebuild t" >/tmp/sc_fence_failure.$$ 2>&1; then
		run "put tunable '$tunable' $reset" >/dev/null
		fail "rebuild unexpectedly succeeded with $tunable=$after"
	fi
	run "put tunable '$tunable' $reset" >/dev/null ||
		fail "could not reset $tunable"
	[[ "$(run "select table_version('t')")" == "$base_version" ]] ||
		fail "failed rebuild changed table version"
	[[ "$(run 'select count(*) from t')" == "2000" ]] ||
		fail "failed rebuild changed table contents"
	[[ "$(fences)" == "$before" ]] ||
		fail "failed rebuild left RAM publication fences"
}

expect_failed_rebuild sc_fence_persist_fail_after 0
expect_failed_rebuild sc_fence_persist_fail_after 1
expect_failed_rebuild sc_fence_test_drop_pending 1 0

# A partial durable write must roll back with the publication transaction.
stop_all_nodes
sleep 10
start_all_nodes
wait_up
master=$(getmaster)
[[ -n "$master" ]] || fail "could not find master after restart"
[[ "$(fences)" == "$base_fences" ]] ||
	fail "partial durable fence set survived transaction abort"

expect_failed_rebuild sc_fence_publish_fail_after 0
expect_failed_rebuild sc_fence_publish_fail_after 1

run "rebuild t" >/dev/null || fail "normal rebuild failed after injections"
(( $(fences) > base_fences )) || fail "normal rebuild published no fences"
[[ "$(run 'select count(*) from t')" == "2000" ]] ||
	fail "normal rebuild changed table contents"

echo "SC_FENCE_FAILURE: base_fences=$base_fences final_fences=$(fences)"
echo "Passed test"