#!/usr/bin/env bash
bash -n "$0" || exit 1

source ${TESTSROOTDIR}/tools/runit_common.sh
set -o pipefail

dbnm=$1
N=${SC_COMMIT_MAP_ROWS:-5000}
master=$(getmaster)
[[ -n "$master" ]] || { echo "FAIL: could not find master"; exit 1; }

run() { cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" "$1"; }
fail() { echo "FAIL: $*"; exit 1; }
counter() {
	cdb2sql ${CDB2_OPTIONS} --host "$master" "$dbnm" \
		"exec procedure sys.cmd.send('bdb clminfo')" 2>/dev/null |
		sed -n "s/.*$1: \([0-9][0-9]*\).*/\1/p" | head -1
}

run "create table t(i int, j int)" >/dev/null
run "create index ix_j on t(j)" >/dev/null
run "insert into t select value, value from generate_series(1, $N)" >/dev/null
expected_sum=$(run "select sum(j) from t")
run "rebuild t" >/dev/null
run "put tunable 'mask_internal_tunables' 0" >/dev/null

fifo=/tmp/sc_epoch_fifo.$$
out=/tmp/sc_epoch_out.$$
mkfifo "$fifo"
cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" - <"$fifo" >"$out" 2>&1 &
pid=$!
exec 9>"$fifo"

printf '%s\n' "set transaction snapshot isolation" "begin" \
	"select count(*) from t" "select sum(j) from t" >&9
sleep 2
run "update t set j = j + 1000 where i <= $((N / 2))" >/dev/null

before=$(counter "SC fence epoch retries")
run "put tunable 'mempv_test_pause_before_cache_put' 1" >/dev/null
run "put tunable 'mempv_test_bump_fence_epoch' 1" >/dev/null
printf '%s\n' "select count(*) from t" "select sum(j) from t" >&9

paused=OFF
for _ in $(seq 1 100); do
	paused=$(run "select value from comdb2_tunables where name='mempv_test_paused'")
	[[ "$paused" == "ON" ]] && break
	sleep 0.1
done
[[ "$paused" == "ON" ]] || fail "reconstruction did not reach the cache-insert pause"

run "put tunable 'mempv_test_pause_before_cache_put' 0" >/dev/null
printf '%s\n' "commit" >&9
exec 9>&-
wait "$pid" || fail "snapshot client failed"
rm -f "$fifo"

mapfile -t vals < <(grep -vE '^\[' "$out")
rm -f "$out"
(( ${vals[0]} == N && ${vals[2]} == N )) ||
	fail "snapshot row count changed across forced epoch race"
[[ "${vals[1]}" == "$expected_sum" && "${vals[3]}" == "$expected_sum" ]] ||
	fail "snapshot sum changed across forced epoch race"

after=$(counter "SC fence epoch retries")
(( after > before )) || fail "epoch change did not force reconstruction retry"

echo "SC_FENCE_EPOCH_RACE: retries_delta=$((after-before)) count=${vals[2]} sum=${vals[3]}"
echo "Passed test"