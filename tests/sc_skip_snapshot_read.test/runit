#!/usr/bin/env bash
bash -n "$0" || exit 1

# Snapshot correctness after a rebuild whose converter commits were skipped.
#
# Omitting converter transactions from the commit-LSN map is only safe if
# nothing still needs their commit LSNs. Versioned-page reconstruction did:
# __mempv_fget() (berkdb/mp/mp_versioned.c) looks up the utxnid that wrote a
# page and, when the lookup MISSES, rolls that operation back out of the
# reconstructed page. A miss is not neutral -- it is treated as "not yet
# committed".
#
# After a rebuild, pages in the new files carry converter LSNs, so a snapshot
# reconstructing one of them undid the row writes and saw an empty table:
#
#   skip enabled, no fence   snapshot count(*) = 0      sum(j) = NULL
#
# The fix is the publication fence. Each physical file the schema change
# rebuilt records the LSN of the scdone record that published its generation.
# Every write forming the initial published image is ordered before that LSN,
# and no snapshot may read the generation before it is published, so
#
#   page_lsn <= fence <= target_lsn
#
# proves the page in hand is already old enough -- without consulting the
# commit map at all. Reconstruction stops there instead of unwinding into
# converter history.
#
# This test asserts both halves at once: the converter entries are STILL
# omitted, and the snapshot is still correct. A fix that merely put the
# entries back would fail the skipped-count assertion.

source ${TESTSROOTDIR}/tools/runit_common.sh

set -o pipefail

dbnm=$1
N=${SC_SKIP_ROWS:-5000}

master=$(getmaster)
[[ -n "$master" ]] || { echo "FAIL: could not find master"; exit 1; }
readonly master N

run() { cdb2sql --tabs ${CDB2_OPTIONS} --host $master $dbnm "$1"; }
fail() { echo "FAIL: $*"; exit 1; }

run "create table t(i int, j int)" > /dev/null
run "create index ix_j on t(j)" > /dev/null
run "insert into t select value, value from generate_series(1, $N)" > /dev/null

expected_sum=$(run 'select sum(j) from t')
run "rebuild t" > /dev/null

skipped=$(cdb2sql ${CDB2_OPTIONS} --host $master $dbnm \
	"exec procedure sys.cmd.send('bdb clminfo')" |
	grep -oP '(?<=SC commit-map entries skipped: )[0-9]+')
(( skipped >= N )) || \
	fail "rebuild skipped only $skipped commit-map entries; this test is only meaningful once the skip is active"

# Hold a snapshot open across concurrent writes. Reading afterwards forces
# reconstruction of pages whose LSNs belong to skipped converter transactions,
# which is the only path that can expose the problem.
fifo=/tmp/sc_skip_fifo.$$
out=/tmp/sc_skip_out.$$
mkfifo $fifo
cdb2sql --tabs ${CDB2_OPTIONS} --host $master $dbnm - < $fifo > $out 2>&1 &
pid=$!
exec 9>$fifo

printf '%s\n' "set transaction snapshot isolation" "begin" \
	"select count(*) from t" "select sum(j) from t" >&9
sleep 3

for k in 1 2 3 4 5; do
	run "update t set j = j + 1000 where i <= $(( N / 2 ))" > /dev/null
done

printf '%s\n' "select count(*) from t" "select sum(j) from t" "commit" >&9
sleep 3

exec 9>&-
wait $pid 2>/dev/null
rm -f $fifo

# Four result rows, in order: count, sum, count, sum.
mapfile -t vals < <(grep -vE '^\[' $out)
rm -f $out

first_count=${vals[0]}
first_sum=${vals[1]}
second_count=${vals[2]}
second_sum=${vals[3]}

# A snapshot must see the table as it was when it started: all N rows, and the
# same sum before and after the concurrent updates.
(( first_count == N )) || \
	fail "snapshot saw $first_count rows immediately after the rebuild, expected $N -- skipped converter entries made reconstruction undo the rebuilt rows"
[[ "$first_sum" == "$expected_sum" ]] || \
	fail "snapshot sum was '$first_sum', expected $expected_sum"

(( second_count == N )) || \
	fail "snapshot saw $second_count rows after concurrent updates, expected $N"
[[ "$second_sum" == "$expected_sum" ]] || \
	fail "snapshot sum changed under it: '$second_sum' vs '$expected_sum'"

# The table itself must still be intact regardless.
rowcount=$(run 'select count(*) from t')
(( rowcount == N )) || fail "table has $rowcount rows, expected $N"

do_verify t

# The fence is what made the reads above correct, not an unrelated change:
# reconstruction must actually have stopped at one. Without this, a fix that
# quietly stopped skipping -- or one where reconstruction never ran -- would
# still pass everything above.
clminfo=$(cdb2sql ${CDB2_OPTIONS} --host $master $dbnm \
	"exec procedure sys.cmd.send('bdb clminfo')")
fence_stops=$(echo "$clminfo" | grep -oP '(?<=SC fence stops: )[0-9]+')
fences=$(echo "$clminfo" | grep -oP '(?<=SC publication fences: )[0-9]+')

(( fences > 0 )) || \
	fail "no publication fences registered; the rebuilt files were never fenced"
(( fence_stops > 0 )) || \
	fail "reconstruction never stopped at a publication fence (stops=$fence_stops);" \
		"the snapshot above was correct for some other reason"

echo "SC_SKIP_SNAPSHOT: rows=$N skipped=$skipped snapshot_count=$first_count snapshot_sum=$first_sum" \
	"fences=$fences fence_stops=$fence_stops"
echo "Passed test"
