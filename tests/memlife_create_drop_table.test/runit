#!/usr/bin/env bash
bash -n "$0" || exit 1

# Lifecycle: table + schema metadata. CREATE -> use -> DROP, same table name
# every time (no unique SQL text, so the fingerprint cache does not grow).
# Invariant: no per-table memory survives DROP.
source ${TESTSROOTDIR}/memlife_common.sh
MEMLIFE_RETENTION="commit_map:until-log-file-deletion"
memlife_reclaim() { memlife_force_log_deletion; }
memlife_iteration() {
    local k
    for k in $(seq 1 20); do
        memlife_sql "CREATE TABLE t (i INT, s TEXT)" >/dev/null
        memlife_sql "INSERT INTO t SELECT value, 'x' FROM generate_series(1, 100)" >/dev/null
        memlife_require "t has 100 rows" test "$(memlife_sql "SELECT count(*) FROM t" --tabs)" = 100
        memlife_sql "DROP TABLE t" >/dev/null
    done
}

memlife_main
