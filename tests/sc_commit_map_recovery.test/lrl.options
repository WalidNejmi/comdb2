# The commit-LSN map only exists when utxnids are logged and snapshot
# isolation is enabled; both are on by default, but this test measures the
# map itself, so state the requirement explicitly rather than inheriting it.
utxnid_log on
enable_snapshot_isolation

# The master omits a converter transaction from the map only when the durable
# marker is in the WAL, which is gated on this writer.  With it off the master
# ADDS every entry (converge-by-add) and skips nothing, and recovery -- honouring
# the same durable marker -- likewise re-adds.  This test characterizes the skip
# path on the live master and across recovery, so turn the writer on.
sc_commit_flags_writer 1

# Suppress periodic checkpoints for the duration of the test. Crash recovery
# replays the physical log forward from the last checkpoint; if a checkpoint
# fired after the converter commits, recovery would start past them and would
# not re-add their commit-map entries, making the regrowth non-deterministic.
# With checkpoints held off, the only checkpoint is the one taken at startup
# (before the table is even created), so recovery is guaranteed to replay every
# converter commit and the characterization is deterministic.
setattr CHECKPOINTTIME 9999999
