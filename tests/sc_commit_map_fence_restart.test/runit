#!/usr/bin/env bash
bash -n "$0" || exit 1

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh
set -o pipefail

dbnm=$1
[[ -z "$dbnm" ]] && dbnm=$DBNAME
master=$(getmaster)
[[ -n "$master" ]] || { echo "FAIL: could not find master"; exit 1; }

run() { cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" "$1"; }
fail() { echo "FAIL: $*"; exit 1; }
fences() {
	cdb2sql ${CDB2_OPTIONS} --host "$master" "$dbnm" \
		"exec procedure sys.cmd.send('bdb clminfo')" 2>/dev/null |
		grep -oP '(?<=SC publication fences: )[0-9]+'
}

run "create table t(i int, j int)" >/dev/null
run "create index ix_j on t(j)" >/dev/null
run "insert into t select value, value from generate_series(1, 5000)" >/dev/null

base=$(fences)
run "rebuild t" >/dev/null || fail "rebuild failed"
published=$(fences)
(( published > base )) || fail "rebuild published no fences"

run "exec procedure sys.cmd.send('flush')" >/dev/null ||
	fail "could not flush before restart"
stop_all_nodes
sleep 10
start_all_nodes
wait_up
master=$(getmaster)
[[ -n "$master" ]] || fail "could not find master after restart"

reloaded=$(fences)
(( reloaded == published )) ||
	fail "reloaded $reloaded fences, expected exact count $published"
[[ "$(run 'select count(*) from t')" == "5000" ]] ||
	fail "table contents changed across restart"

echo "SC_FENCE_RESTART: published=$published reloaded=$reloaded"
echo "Passed test"