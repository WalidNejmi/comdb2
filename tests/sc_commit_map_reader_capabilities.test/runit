#!/usr/bin/env bash
bash -n "$0" || exit 1

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh
set -o pipefail

dbnm=$1
master=$(getmaster)
[[ -n "$master" ]] || { echo "FAIL: could not find master"; exit 1; }

old_pid=
capable_pid=
cleanup() {
    [[ -n "$old_pid" ]] && kill "$old_pid" 2>/dev/null || true
    [[ -n "$capable_pid" ]] && kill "$capable_pid" 2>/dev/null || true
    wait "$old_pid" 2>/dev/null || true
    wait "$capable_pid" 2>/dev/null || true
    rm -f /tmp/sc_reader_old.$$ /tmp/sc_reader_capable.$$
}
trap cleanup EXIT

run() { cdb2sql --tabs ${CDB2_OPTIONS} --host "$master" "$dbnm" "$1"; }
fail() { echo "FAIL: $*"; exit 1; }
metric() {
    cdb2sql ${CDB2_OPTIONS} --host "$master" "$dbnm" \
        "exec procedure sys.cmd.send('bdb clminfo')" 2>/dev/null |
        sed -n "s/.*$1: \([0-9][0-9]*\).*/\1/p" | head -1
}
wait_metric() {
    local label=$1 want=$2 value
    for _ in $(seq 1 100); do
        value=$(metric "$label")
        [[ "$value" == "$want" ]] && return 0
        sleep 0.2
    done
    fail "$label did not reach $want (last=$value)"
}

wait_metric "SC cluster supports commit flags" 1

nodes=($(getclusternodes))
incapable=
for node in "${nodes[@]}"; do
    [[ "$node" != "$master" ]] && incapable=$node && break
done
if [[ -n "$incapable" ]]; then
    cdb2sql --tabs ${CDB2_OPTIONS} --host "$incapable" "$dbnm" \
        "put tunable 'sc_commit_flags_advertise' 0" >/dev/null ||
        fail "could not suppress capability on $incapable"
    wait_metric "SC cluster supports commit flags" 0

    cdb2sql --tabs ${CDB2_OPTIONS} --host "$incapable" "$dbnm" \
        "put tunable 'sc_commit_flags_advertise' 1" >/dev/null ||
        fail "could not restore capability on $incapable"
    wait_metric "SC cluster supports commit flags" 1
fi

start_lsn=$(run "select lsn from comdb2_transaction_logs(NULL, NULL, 4) limit 1")
run "select lsn from comdb2_transaction_logs('$start_lsn', NULL, 9, 3)" \
    >/tmp/sc_reader_old.$$ 2>&1 &
old_pid=$!
wait_metric "SC incapable log streams" 1
wait_metric "SC cluster supports commit flags" 0

wait "$old_pid" 2>/dev/null || true
old_pid=
wait_metric "SC incapable log streams" 0
wait_metric "SC cluster supports commit flags" 1

capable_start=$(run "select lsn from comdb2_transaction_logs(NULL, NULL, 4) limit 1")
run "select lsn from comdb2_transaction_logs('$capable_start', NULL, 9, 3, NULL, 1)" \
    >/tmp/sc_reader_capable.$$ 2>&1 &
capable_pid=$!
sleep 1
[[ "$(metric 'SC incapable log streams')" == "0" ]] ||
    fail "V1 transaction-log reader was counted as incapable"
[[ "$(metric 'SC cluster supports commit flags')" == "1" ]] ||
    fail "V1 transaction-log reader closed the cluster capability"

wait "$capable_pid" 2>/dev/null || true
capable_pid=

echo "SC_READER_CAPABILITIES: replica=${incapable:-single-node} old_stream=blocked capable_stream=accepted"
echo "Passed test"