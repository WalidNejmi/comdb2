#!/usr/bin/env bash
bash -n "$0" || exit 1

# Lifecycle: rows of the comdb2_procedures system table (version strings are
# allocated per row; historical leak fixed in 3aa6939f5, systbl_proc_leak).
# Invariant: reading the system table frees what it allocates.
source ${TESTSROOTDIR}/memlife_common.sh
memlife_setup() {
    local i
    for i in $(seq 1 100); do memlife_sql "CREATE PROCEDURE sp$i { local function main (e) end }" >/dev/null; done
    memlife_require "100 procedures" test "$(memlife_sql "SELECT count(*) FROM comdb2_procedures WHERE name LIKE 'sp%'" --tabs)" = 100
    sleep 5   # longer than sqlenginepool linger: start from zero SQL threads
}
selects() { seq 1 200 | sed 's/.*/SELECT name, version FROM comdb2_procedures/'; }
memlife_iteration() { memlife_batch selects; }

memlife_main
