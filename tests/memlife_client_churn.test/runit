#!/usr/bin/env bash
bash -n "$0" || exit 1

# Lifecycle: per-connection state. 100 clean connect/query/disconnect plus 20
# abrupt disconnects (client killed during a query) per iteration.
# Invariant: client/session state does not grow with the number of clients.
source ${TESTSROOTDIR}/memlife_common.sh
base_conns=0
nconns() { $SQLM --tabs "SELECT count(*) FROM comdb2_connections"; }
memlife_setup() { $SQLM "CREATE TABLE t (i INT)" >/dev/null; $SQLM "INSERT INTO t SELECT value FROM generate_series(1, 100)" >/dev/null; }
memlife_iteration() {
    local k p
    for k in $(seq 1 100); do $SQLM "SELECT count(*) FROM t WHERE i > 10" >/dev/null; done
    for k in $(seq 1 ${MEMLIFE_CHURN_ABRUPT:-20}); do   # 0: clean disconnects only
        $SQLM "SELECT sleep(5)" >/dev/null 2>&1 & p=$!
        sleep 0.3; kill -9 $p 2>/dev/null; wait $p 2>/dev/null
    done
}
memlife_settle() {   # wait until the server has torn down the killed sessions
    local i
    for (( i = 0; i < 30; i++ )); do (( $(nconns) <= base_conns + 1 )) && break; sleep 1; done
    sleep 1
}
memlife_warmup() { memlife_iteration 0; sleep 6; base_conns=$(nconns); }

memlife_main
