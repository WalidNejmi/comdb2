#!/usr/bin/env bash
bash -n "$0" || exit 1

# Explicit reclamation test: commit_map grows by one entry per commit while log
# deletion is off, and must shrink when the log files holding those commits
# are deleted (bdb delete_log_files -> __txn_commit_map_delete_logfile_txns).
source ${TESTSROOTDIR}/memlife_common.sh
MEMLIFE_RETENTION="commit_map:until-log-file-deletion"
logfiles() { ls ${DBDIR:-$TESTDIR/$dbnm}/logs 2>/dev/null | grep -c '^log\.'; }
memlife_setup() {
    $SQLM "CREATE TABLE t (i INT, s TEXT)" >/dev/null
    $SQLM "EXEC PROCEDURE sys.cmd.send('sync log-delete off')" >/dev/null
}
memlife_iteration() {
    seq 1 3000 | sed "s/.*/INSERT INTO t VALUES (&, 'kept until log deletion')/" | $SQLM - >/dev/null
    echo -e "$1\t$(logfiles)" >> $MEMLIFE_DIR/logfiles.tsv
}
memlife_reclaim() {
    memlife_force_log_deletion
    echo -e "RECLAIM\t$(logfiles)" >> $MEMLIFE_DIR/logfiles.tsv
}

memlife_main
